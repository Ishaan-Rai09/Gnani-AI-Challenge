{
  "name": "CallShield — Call Screening",
  "short_name": "CallShield",
  "description": "Your calls. Your control. An AI assistant screens unknown callers and flags suspicious conversations before they reach you.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F5F3ED",
  "theme_color": "#151B26",
  "categories": ["security", "utilities", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Live screening",
      "short_name": "Live",
      "description": "Open live call screening",
      "url": "/app/live",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Call history",
      "short_name": "History",
      "description": "Review screened calls",
      "url": "/app/history",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
