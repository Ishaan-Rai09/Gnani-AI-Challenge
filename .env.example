# MongoDB (Atlas) — per-user call history and blocklist.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/callshieldAI?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth — required for Google sign-in.
# Generate with: npx auth secret  (or any long random string)
AUTH_SECRET=

# Google OAuth credentials — create an OAuth client at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Without MONGODB_URI and the Google credentials the app cannot sign in;
# history and blocklist are stored per Google account in MongoDB.

# Gnani voice integration (optional; captions-only when absent)
# GNANI_API_KEY=
# GNANI_BASE_URL=
