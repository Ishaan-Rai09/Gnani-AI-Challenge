# CallShield — server-side voice configuration (Gnani Speech APIs).
#
# Copy this file to .env.local and paste your key. The key is read only by
# Next.js route handlers; it is never exposed to the browser. Never prefix it
# with NEXT_PUBLIC_.
#
# Without a key the app runs in captions-only demo mode, and every call still
# works end to end.

GNANI_API_KEY=
# Optional — defaults to https://api.vachana.ai
GNANI_BASE_URL=https://api.vachana.ai
# Optional model overrides
# GNANI_TTS_MODEL=timbre-v2.5
# GNANI_STT_MODEL=prisma-v2.5
